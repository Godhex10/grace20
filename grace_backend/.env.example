# G.R.A.C.E. environment configuration
# Copy this file to `.env` (same folder) and fill in the keys you want.
# Every key is OPTIONAL — the app runs without any of them, just with fewer features.

# --- AI reasoning (Tier 2 chat) ---
# Enables conversational answers via Google Gemini. Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: override the model (defaults to gemini-2.5-flash)
# GRACE_MODEL=gemini-2.5-flash

# --- Live web search ---
# Enables the web_search tool so Gemini can fetch current/real-time info.
# Get a free key (no card) at https://tavily.com
TAVILY_API_KEY=

# --- Live traffic map tiles ---
# Enables the traffic overlay on the map. Get a key at https://developer.tomtom.com
TOMTOM_API_KEY=

# --- Voice synthesis (optional tuning) ---
# GRACE_VOICE=en-GB-SoniaNeural
# GRACE_VOICE_RATE=+18%
