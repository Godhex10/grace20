[Unit]
Description=Grace backend (FastAPI / uvicorn)
After=network.target

[Service]
Type=simple
User=ubuntu
# One process (NOT --workers): Grace's background scheduler (reminders, briefings)
# must run exactly once. The app reads .env from WorkingDirectory via load_dotenv().
WorkingDirectory=/home/ubuntu/gracev2-main/grace_backend
ExecStart=/home/ubuntu/gracev2-main/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
