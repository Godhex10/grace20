# ── Secrets — NEVER commit these ──────────────────────────────────────────
.env
*.env
!*.env.example
GRACE_SETUP_KEYS.txt
*_KEYS.txt
grace_backend/.env
google_token.json
grace_backend/google_token.json
*token*.json
*.key
*.pem

# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ── Databases / backups (local data, not source) ──────────────────────────
*.db
*.db.bak
*.sqlite
*.sqlite3
.grace/
grace-backups/

# ── Logs / build output text ──────────────────────────────────────────────
*.log
build_log.txt
build_onefile_log.txt

# ── Generated TTS audio cache (runtime, not source) ───────────────────────
grace_backend/static/audio/
grace_backend/screenshots/

# ── Editor / OS / build artifacts ─────────────────────────────────────────
.claude/settings.local.json
*.vsix
.DS_Store
Thumbs.db
~$*

# ── Large / legacy binaries (regeneratable, not needed in the repo) ────────
grace_backend/piper_voices/

# ── PyInstaller build output (regeneratable from the .spec files) ──────────
build/
dist/
build_onefile/
dist_onefile/
*.manifest
