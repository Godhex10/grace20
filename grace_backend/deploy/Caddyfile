# Grace reverse proxy — Caddy gives automatic HTTPS (free Let's Encrypt cert)
# and streams Server-Sent Events immediately (flush_interval -1), which Grace's
# real-time push needs.
#
# Replace the domain below with YOUR domain — e.g. a free DuckDNS subdomain
# (grace-yourname.duckdns.org) pointed at this VM's public IP. Caddy will fetch
# the TLS certificate on first start automatically.

your-domain.duckdns.org {
    reverse_proxy 127.0.0.1:8000 {
        flush_interval -1
    }
}

